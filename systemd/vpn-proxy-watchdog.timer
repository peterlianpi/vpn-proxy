[Unit]
Description=Run the vpn-proxy self-heal watchdog every 60 seconds
Documentation=https://github.com/peterlianpi/vpn-proxy

[Timer]
Unit=vpn-proxy-watchdog.service
# First check 2 minutes after boot (vpn-proxy may still be starting);
# then once a minute.
OnBootSec=120s
OnUnitActiveSec=60s
AccuracySec=10s

[Install]
# Enabling `vpn-proxy` also enables this timer, because vpn-proxy.service
# carries Wants=vpn-proxy-watchdog.timer. `systemctl enable --now
# vpn-proxy` is therefore sufficient to get self-healing.
WantedBy=multi-user.target