[Unit]
Description=Outline VPN transparent proxy
Documentation=https://github.com/peterlianpi/vpn-proxy
After=network-online.target nss-lookup.target vpn-proxy-watchdog.timer
Wants=network-online.target
Wants=vpn-proxy-watchdog.timer
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
# oneshot + RemainAfterExit: proxy.sh backgrounds ss-redir, records a
# pidfile and returns. systemd then reports `active (exited)` forever,
# which is why Restart=on-failure below almost never fires — a start that
# succeeded once is never retried. Self-healing therefore lives in
# vpn-proxy-watchdog.timer, which restarts this unit if ss-redir, the
# nat SS_REDIR jump or the selective ipset dies while the unit is active.
# Type=simple is NOT used: proxy.sh forks ss-redir and returns, so
# systemd would see the main process exit immediately and (with
# Restart=always) storm-restart the unit.
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/vpn-proxy
RuntimeDirectory=vpn-proxy
# Keep /run/vpn-proxy across a stop. A CLEAN stop already deletes
# active-mode (clean_tproxy -> clear_active_mode), so a surviving file means
# the stop did not run to completion — a crash, a kill -9, a failed
# ExecStop. That is exactly the case where status and the watchdog need to
# read the last known mode. Without this, systemd deletes the directory on
# every stop and an unclean stop erases the only evidence of what was live.
RuntimeDirectoryPreserve=yes
Environment=VP_LOG_DIR=/var/log/vpn-proxy
# VP_SYSTEMD=1 is proxy.sh's recursion guard. Without it, `sudo vpn-proxy
# start` (which now delegates to `systemctl start vpn-proxy`) would make the
# ExecStart below re-delegate to systemctl, forever. With it, the in-unit
# run does the work itself. proxy.sh checks BOTH this and INVOCATION_ID, so
# an older unit file that predates this line is still guarded by systemd's
# own INVOCATION_ID. Do not remove it.
Environment=VP_SYSTEMD=1
ExecStartPre=/opt/vpn-proxy/lib/wait-network.sh
ExecStart=/usr/local/bin/vpn-proxy start
ExecStop=/usr/local/bin/vpn-proxy stop
# A delegated `start` first waits for DNS (ExecStartPre), then starts
# ss-redir and resolves domains.txt into ipset; at boot with a slow link
# that is easily over three minutes.
TimeoutStartSec=300
TimeoutStopSec=45
Restart=on-failure
RestartSec=15

[Install]
# WantedBy=multi-user.target brings this unit in on boot. The
# Wants=vpn-proxy-watchdog.timer above pulls the watchdog timer in with it.
WantedBy=multi-user.target